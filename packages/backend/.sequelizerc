// Sequelize CLI doesn't support TypeScript config directly,
// so we use .sequelizerc (JavaScript) to point to our TS files

const path= require('path');

module.exports = {
  'config': path.resolve('src', 'config', 'database.config.cjs'),
  'models-path': path.resolve('src', 'models'),
  'seeders-path': path.resolve('src', 'database', 'seeders'),
  'migrations-path': path.resolve('src', 'database', 'migrations'),
};